# ==============================================================================
# ICS/OT Threat Detection Signatures for Modbus TCP (Port 502)
# Standard Reference: IEC 62443-3-3 System Security Requirements
# Target Environment: Level 1 / Level 2 Control Zone (Purdue Model)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. UNAUTHORIZED WRITE ATTEMPTS (Function Code 05 - Write Single Coil)
# Attacker attempting to toggle actuators (Pumps, Valves, Alarm Beacons)
# ------------------------------------------------------------------------------
alert tcp !$ENGINEERING_STATION any -> $PLC_ZONE 502 ( \
    msg:"OT-ATTACK: Modbus TCP Unauthorized Write Single Coil (FC 05)"; \
    flow:to_server,established; \
    content:"|00 00|"; offset:2; depth:2; \
    byte_test:1,=,5,7; \
    classtype:attempted-admin; \
    sid:1000001; rev:1; \
)

# ------------------------------------------------------------------------------
# 2. UNAUTHORIZED SETPOINT MODIFICATION (Function Code 06 - Write Single Register)
# Any device other than the authorized Engineering Workstation issuing FC 06
# ------------------------------------------------------------------------------
alert tcp !$ENGINEERING_STATION any -> $PLC_ZONE 502 ( \
    msg:"OT-ATTACK: Modbus TCP Unauthorized Write Single Register (FC 06)"; \
    flow:to_server,established; \
    content:"|00 00|"; offset:2; depth:2; \
    byte_test:1,=,6,7; \
    classtype:attempted-admin; \
    sid:1000002; rev:1; \
)

# ------------------------------------------------------------------------------
# 3. SETPOINT TAMPERING - HIGH THRESHOLD OUT-OF-BOUNDS INJECTION (> 900 / 0x0384)
# In OpenPLC, Holding Register 0 (%QW0) represents the upper safe threshold.
# Values > 900 represent an overfill hazard.
# ------------------------------------------------------------------------------
alert tcp any any -> $PLC_ZONE 502 ( \
    msg:"OT-ANOMALY: Modbus TCP Water Tank Upper Limit Threshold Violation (> 900)"; \
    flow:to_server,established; \
    content:"|00 00|"; offset:2; depth:2; \
    byte_test:1,=,6,7; \
    content:"|00 00|"; offset:8; depth:2; \
    byte_test:2,>,900,10; \
    classtype:policy-violation; \
    sid:1000003; rev:1; \
)

# ------------------------------------------------------------------------------
# 4. MODBUS RECONNAISSANCE - ILLEGAL DATA ADDRESS EXCEPTION (Code 0x02)
# Indicates scanner probing undefined memory offsets
# ------------------------------------------------------------------------------
alert tcp $PLC_ZONE 502 -> any any ( \
    msg:"OT-RECON: Modbus TCP Server Returned Exception (Illegal Data Address 0x02)"; \
    flow:from_server,established; \
    content:"|00 00|"; offset:2; depth:2; \
    byte_test:1,&,0x80,7; \
    content:"|02|"; offset:8; depth:1; \
    classtype:bad-unknown; \
    sid:1000004; rev:1; \
)

# ------------------------------------------------------------------------------
# 5. DIAGNOSTICS & VENDOR CODE PROBING (Function Code 08)
# Diagnostic commands should never originate from operational HMI loops
# ------------------------------------------------------------------------------
alert tcp any any -> $PLC_ZONE 502 ( \
    msg:"OT-RECON: Modbus TCP Diagnostic Function Code Probed (FC 08)"; \
    flow:to_server,established; \
    content:"|00 00|"; offset:2; depth:2; \
    byte_test:1,=,8,7; \
    classtype:suspicious-traffic; \
    sid:1000005; rev:1; \
)
