# Python virtual environments & bytecode
.venv/
__pycache__/
*.py[cod]
*$py.class

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Local IDE configuration
.vscode/
.idea/
*.swp
*.swo

# Transient log captures (keep directory structure)
*.log

# Generated X.509 PKI material (regenerated by generate_opcua_certs.py / on
# container start) — never commit private keys or certificates.
certs/*.pem
certs/*.der
